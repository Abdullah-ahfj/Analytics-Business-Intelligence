cat("===================================\n\n")
cat("Number of Relationships (Edges):\n")
print(nrow(network_data))
cat("\nNumber of Stakeholders (Nodes):\n")
print(length(stakeholders))
cat("\nStakeholders:\n")
print(stakeholders)
