# ============================================================
# STEP B2 - NETWORK CONSTRUCTION AND VISUALIZATION
# ============================================================
# ------------------------------------------------------------
# 1. Install and Load igraph
# ------------------------------------------------------------
if (!require(igraph)) {
install.packages("igraph")
library(igraph)
} else {
library(igraph)
}
# ------------------------------------------------------------
# 2. Construct Aviation Stakeholder Network
# ------------------------------------------------------------
aviation_network <- graph_from_data_frame(
d = network_data,
directed = FALSE
)
# ------------------------------------------------------------
# 3. Display Basic Network Information
# ------------------------------------------------------------
print(aviation_network)
cat("\nNumber of Nodes:", vcount(aviation_network), "\n")
cat("Number of Edges:", ecount(aviation_network), "\n")
# ------------------------------------------------------------
# 4. Assign Relationship Type and Weight to Edges
# ------------------------------------------------------------
E(aviation_network)$relationship <- network_data$Relationship
E(aviation_network)$weight <- network_data$Weight
# ------------------------------------------------------------
# 5. Assign Edge Colours According to Relationship Type
# ------------------------------------------------------------
relationship_colours <- c(
"Commercial" = "steelblue",
"Operational" = "darkorange",
"Regulatory" = "firebrick",
"Support" = "forestgreen"
)
E(aviation_network)$color <-
relationship_colours[E(aviation_network)$relationship]
# ------------------------------------------------------------
# 6. Make Edge Thickness Reflect Relationship Weight
# ------------------------------------------------------------
E(aviation_network)$width <-
1 + (E(aviation_network)$weight / 3)
# ------------------------------------------------------------
# 7. Calculate Degree for Node Size
# ------------------------------------------------------------
node_degree <- degree(
aviation_network,
mode = "all"
)
# Larger degree = larger node on graph
V(aviation_network)$size <-
12 + (node_degree * 2)
# ------------------------------------------------------------
# 8. Set Node Appearance
# ------------------------------------------------------------
V(aviation_network)$color <- "lightblue"
V(aviation_network)$frame.color <- "black"
V(aviation_network)$label.color <- "black"
V(aviation_network)$label.cex <- 0.75
# ------------------------------------------------------------
# 9. Generate Reproducible Network Layout
# ------------------------------------------------------------
set.seed(123)
network_layout <- layout_with_fr(
aviation_network
)
# ------------------------------------------------------------
# 10. Save Professional Network Graph
# ------------------------------------------------------------
png(
"Task_B_Figures/B02_Aviation_Stakeholder_Network.png",
width = 1800,
height = 1400,
res = 170
)
par(
mar = c(1, 1, 4, 1)
)
plot(
aviation_network,
layout = network_layout,
vertex.size = V(aviation_network)$size,
vertex.color = V(aviation_network)$color,
vertex.frame.color = V(aviation_network)$frame.color,
vertex.label.color = V(aviation_network)$label.color,
vertex.label.cex = 0.75,
edge.color = E(aviation_network)$color,
edge.width = E(aviation_network)$width,
main = "Sri Lanka Aviation Stakeholder Network"
)
legend(
"bottomleft",
legend = names(relationship_colours),
col = relationship_colours,
lty = 1,
lwd = 4,
cex = 0.8,
title = "Relationship Type",
bty = "n"
)
mtext(
"Node size represents number of direct stakeholder connections",
side = 1,
line = -1,
cex = 0.75
)
dev.off()
# ------------------------------------------------------------
# 11. Display Network in RStudio Plot Window
# ------------------------------------------------------------
plot(
aviation_network,
layout = network_layout,
vertex.size = V(aviation_network)$size,
vertex.color = V(aviation_network)$color,
vertex.frame.color = V(aviation_network)$frame.color,
vertex.label.color = V(aviation_network)$label.color,
vertex.label.cex = 0.75,
edge.color = E(aviation_network)$color,
edge.width = E(aviation_network)$width,
main = "Sri Lanka Aviation Stakeholder Network"
)
legend(
"bottomleft",
legend = names(relationship_colours),
col = relationship_colours,
lty = 1,
lwd = 4,
cex = 0.8,
title = "Relationship Type",
bty = "n"
)
# ============================================================
# END OF STEP B2
# ============================================================
cat("\nNetwork graph successfully created.\n")
cat("Saved as: Task_B_Figures/B02_Aviation_Stakeholder_Network.png\n")
# ============================================================
# STEP B2 (IMPROVED) - NETWORK CONSTRUCTION AND VISUALIZATION
# ============================================================
# 1. Install and Load igraph
if (!require(igraph)) {
install.packages("igraph")
library(igraph)
} else {
library(igraph)
}
# 2. Construct Aviation Stakeholder Network
aviation_network <- graph_from_data_frame(d = network_data, directed = FALSE)
print(aviation_network)
cat("\nNumber of Nodes:", vcount(aviation_network), "\n")
cat("Number of Edges:", ecount(aviation_network), "\n")
# 3. Assign Relationship Type and Weight to Edges
E(aviation_network)$relationship <- network_data$Relationship
E(aviation_network)$weight <- network_data$Weight
relationship_colours <- c(
"Commercial" = "steelblue",
"Operational" = "darkorange",
"Regulatory" = "firebrick",
"Support" = "forestgreen"
)
E(aviation_network)$color <- relationship_colours[E(aviation_network)$relationship]
E(aviation_network)$width <- 1 + (E(aviation_network)$weight / 3)
# 4. NEW: Categorize nodes by stakeholder type
stakeholder_category <- c(
"Bandaranaike International Airport (CMB)" = "Airport",
"Mattala Rajapaksa International Airport (MRIA)" = "Airport",
"Civil Aviation Authority of Sri Lanka (CAASL)" = "Regulator",
"Airport & Aviation Services SL (AASL)" = "Operator",
"SriLankan Airlines" = "Airline",
"Mihin Lanka" = "Airline",
"International Airlines" = "Airline",
"Air Traffic Control (ATC)" = "ATC",
"Ground Handling Unit" = "Ground Ops",
"Maintenance & Engineering" = "Ground Ops",
"Customs & Immigration" = "Security/Border",
"Sri Lanka Air Force" = "Security/Border",
"Fuel Supply Companies" = "Support",
"Tourism Authority" = "Support",
"Cargo Operators" = "Support"
)
category_colours <- c(
"Airport" = "#4C72B0", "Regulator" = "#C44E52", "Operator" = "#8172B2",
"Airline" = "#55A868", "ATC" = "#CCB974", "Ground Ops" = "#64B5CD",
"Security/Border" = "#DD8452", "Support" = "#937860"
)
V(aviation_network)$category <- stakeholder_category[V(aviation_network)$name]
V(aviation_network)$color <- category_colours[V(aviation_network)$category]
# 5. NEW: Size nodes by normalized degree centrality
deg_cent <- degree(aviation_network, normalized = TRUE)
V(aviation_network)$size <- 14 + (deg_cent * 60)
# 6. NEW: Flag top-3 critical bridge nodes (highest betweenness)
bet_cent <- betweenness(aviation_network, normalized = TRUE)
is_bridge <- bet_cent >= sort(bet_cent, decreasing = TRUE)[3]
V(aviation_network)$frame.color <- ifelse(is_bridge, "red", "black")
V(aviation_network)$frame.width <- ifelse(is_bridge, 3, 1)
V(aviation_network)$label.color <- "black"
V(aviation_network)$label.cex <- 0.7
# 7. Generate Reproducible Network Layout
set.seed(123)
network_layout <- layout_with_fr(aviation_network, niter = 2000, area = vcount(aviation_network)^2.3)
# ============================================================
# STEP B2 (IMPROVED) - NETWORK CONSTRUCTION AND VISUALIZATION
# ============================================================
# ------------------------------------------------------------
# 1. Install and Load igraph
# ------------------------------------------------------------
if (!requireNamespace("igraph", quietly = TRUE)) {
install.packages("igraph")
}
library(igraph)
# ------------------------------------------------------------
# 2. Construct Aviation Stakeholder Network
# ------------------------------------------------------------
aviation_network <- graph_from_data_frame(
d = network_data,
directed = FALSE
)
print(aviation_network)
cat("\nNumber of Nodes:", vcount(aviation_network), "\n")
cat("Number of Edges:", ecount(aviation_network), "\n")
# ------------------------------------------------------------
# 3. Assign Relationship Type and Weight to Edges
# ------------------------------------------------------------
E(aviation_network)$relationship <- network_data$Relationship
E(aviation_network)$weight <- network_data$Weight
# Relationship colours
relationship_colours <- c(
"Commercial" = "steelblue",
"Operational" = "darkorange",
"Regulatory" = "firebrick",
"Support" = "forestgreen"
)
E(aviation_network)$color <-
relationship_colours[E(aviation_network)$relationship]
# Edge thickness represents relationship weight
E(aviation_network)$width <-
1 + (E(aviation_network)$weight / 3)
# ------------------------------------------------------------
# 4. Categorize Nodes by Stakeholder Type
# ------------------------------------------------------------
stakeholder_category <- c(
"Bandaranaike International Airport (CMB)" = "Airport",
"Mattala Rajapaksa International Airport (MRIA)" = "Airport",
"Civil Aviation Authority of Sri Lanka (CAASL)" = "Regulator",
"Airport & Aviation Services SL (AASL)" = "Operator",
"SriLankan Airlines" = "Airline",
"Mihin Lanka" = "Airline",
"International Airlines" = "Airline",
"Air Traffic Control (ATC)" = "ATC",
"Ground Handling Unit" = "Ground Ops",
"Maintenance & Engineering" = "Ground Ops",
"Customs & Immigration" = "Security/Border",
"Sri Lanka Air Force" = "Security/Border",
"Fuel Supply Companies" = "Support",
"Tourism Authority" = "Support",
"Cargo Operators" = "Support"
)
# Colours for stakeholder categories
category_colours <- c(
"Airport" = "#4C72B0",
"Regulator" = "#C44E52",
"Operator" = "#8172B2",
"Airline" = "#55A868",
"ATC" = "#CCB974",
"Ground Ops" = "#64B5CD",
"Security/Border" = "#DD8452",
"Support" = "#937860"
)
# Assign stakeholder categories
V(aviation_network)$category <-
stakeholder_category[V(aviation_network)$name]
# Assign node colours
V(aviation_network)$color <-
category_colours[V(aviation_network)$category]
# ------------------------------------------------------------
# 5. Size Nodes by Normalized Degree Centrality
# ------------------------------------------------------------
deg_cent <- degree(
aviation_network,
mode = "all",
normalized = TRUE
)
# Larger node = more direct stakeholder connections
V(aviation_network)$size <-
14 + (deg_cent * 60)
# ------------------------------------------------------------
# 6. Identify Top-3 Critical Bridge Nodes
# ------------------------------------------------------------
bet_cent <- betweenness(
aviation_network,
directed = FALSE,
normalized = TRUE
)
# Identify exactly the top three nodes by betweenness
top3_bridge <- order(
bet_cent,
decreasing = TRUE
)[1:3]
# Create logical bridge indicator
is_bridge <- rep(
FALSE,
vcount(aviation_network)
)
is_bridge[top3_bridge] <- TRUE
# Red border for critical bridge nodes
V(aviation_network)$frame.color <-
ifelse(
is_bridge,
"red",
"black"
)
V(aviation_network)$frame.width <-
ifelse(
is_bridge,
3,
1
)
# Node labels
V(aviation_network)$label.color <- "black"
V(aviation_network)$label.cex <- 0.7
# ------------------------------------------------------------
# 7. Generate Reproducible Network Layout
# ------------------------------------------------------------
set.seed(123)
network_layout <- layout_with_fr(
aviation_network,
niter = 2000
)
# ------------------------------------------------------------
# 8. Save Improved Network Graph
# ------------------------------------------------------------
png(
"Task_B_Figures/B02_Aviation_Stakeholder_Network_Improved.png",
width = 2000,
height = 1600,
res = 170
)
